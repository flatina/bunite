{
  "name": "bunite-workspace",
  "description": "Uniting UI and Bun",
  "private": true,
  "type": "module",
  "workspaces": [
    "package",
    "tools/*",
    "examples/*",
    "tests/*"
  ],
  "scripts": {
    "typecheck": "bun x tsc -b --noEmit && bun run --filter './examples/*' typecheck && bun run --filter './tests/*' typecheck",
    "check": "bun run typecheck",
    "build:native:win": "cmake -S package -B package/build/win -DBUNITE_TARGET_ARCH=x64 && cmake --build package/build/win --config Release",
    "build:native:mac": "cmake -S package -B package/build/mac -DCMAKE_BUILD_TYPE=Release -DBUNITE_TARGET_ARCH=arm64 && cmake --build package/build/mac",
    "build:native:mac:x64": "cmake -S package -B package/build/mac-x64 -DCMAKE_BUILD_TYPE=Release -DBUNITE_TARGET_ARCH=x64 && cmake --build package/build/mac-x64"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.2"
  }
}
